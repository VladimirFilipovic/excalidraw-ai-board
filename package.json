{
  "name": "excalidraw-ai-board",
  "version": "1.0.0",
  "description": "Local Excalidraw desktop app + JSON CLI for AI agents",
  "main": "electron/main.cjs",
  "scripts": {
    "prebuild": "node -e \"require('fs').cpSync('node_modules/@excalidraw/excalidraw/dist/prod/fonts','renderer/public/fonts',{recursive:true})\"",
    "build": "vite build",
    "app": "electron .",
    "start": "vite build && electron .",
    "dev": "vite build --watch"
  },
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@excalidraw/mermaid-to-excalidraw": "^2.2.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.5",
    "vite": "^8.3.1"
  },
  "bin": {
    "exd": "bin/exd.mjs"
  }
}
